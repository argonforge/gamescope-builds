#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_LDFLAGS_MAINT_APPEND = -fuse-ld=lld -Wl,-O1,--sort-common,--as-needed

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- \
		--bindir /usr/games \
		-Dpipewire=enabled \
		-Denable_openvr_support=false

override_dh_dwz:
	@echo "Skipping dh_dwz (Clang debug sections)"
