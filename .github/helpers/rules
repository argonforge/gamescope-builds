#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CFLAGS_MAINT_APPEND = -march=x86-64-v4 -mtune=znver4 -O3 -fno-plt -fomit-frame-pointer -falign-functions=32 -falign-loops=32
export DEB_CXXFLAGS_MAINT_APPEND = -march=x86-64-v4 -mtune=znver4 -O3 -fno-plt -fomit-frame-pointer -falign-functions=32 -falign-loops=32
export DEB_LDFLAGS_MAINT_APPEND = -fuse-ld=lld -Wl,-O1,--sort-common,--as-needed

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- \
		--bindir /usr/games \
		-Dpipewire=enabled \
		-Denable_openvr_support=false

override_dh_dwz:
	@echo "Skipping dh_dwz (Clang debug sections)"
